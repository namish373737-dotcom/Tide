{
  "expo": {
    "name": "Solace",
    "slug": "solace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.solace.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Solace uses Face ID to protect your health data.",
        "NSHealthShareUsageDescription": "Solace reads step count and heart rate to help enrich your symptom patterns.",
        "NSHealthUpdateUsageDescription": "Solace does not write to Apple Health."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D7377"
      },
      "package": "com.solace.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      "expo-notifications",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D7377"
        }
      ]
    ],
    "scheme": "solace",
    "extra": {
      "eas": {
        "projectId": "PLACEHOLDER_RUN_EAS_INIT"
      }
    }
  }
}
